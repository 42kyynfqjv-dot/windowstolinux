# Converter includes Rust source verbatim; both hosts must see identical bytes.
*.rs text eol=lf
# Compiler fixture provenance compares the actual compiled source bytes.
*.c text eol=lf
# Cross-host option vectors are hashed as exact source bytes.
research/crt/option-state-vectors.json text eol=lf

# Research source provenance is checked byte-for-byte across hosts.
research/crt/*onexit*.py text eol=lf
research/crt/*sentinel*.py text eol=lf
research/crt/sentinel-vectors.json text eol=lf
research/crt/*commode*.py text eol=lf
