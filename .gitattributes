# Converter includes Rust source verbatim; both hosts must see identical bytes.
*.rs text eol=lf
# Compiler fixture provenance compares the actual compiled source bytes.
*.c text eol=lf
# Cross-host option vectors are hashed as exact source bytes.
research/crt/option-state-vectors.json text eol=lf

# Research source provenance is checked byte-for-byte across hosts.
research/crt/*onexit*.py text eol=lf
research/crt/*sentinel*.py text eol=lf
research/crt/sentinel-vectors.json text eol=lf
research/crt/*commode*.py text eol=lf
research/crt/check_external_cell.py text eol=lf
research/crt/*accessor*.py text eol=lf
research/crt/*runtime*.py text eol=lf
research/crt/*composition*.py text eol=lf
research/input/*.py text eol=lf
research/input/*.json text eol=lf

research/input/diversity/*.py text eol=lf
research/input/diversity/*.json text eol=lf

research/input/scalar/*.py text eol=lf

# Frozen held-out input vectors must retain preregistered bytes on Windows.
research/input/heldout/*.json text eol=lf
research/input/heldout/*.py text eol=lf
research/input/postcall/*.json text eol=lf
research/input/postcall/*.py text eol=lf

# Frozen CLI provenance must survive Windows checkout.
research/cli/*.json text eol=lf
research/cli/*.py text eol=lf
