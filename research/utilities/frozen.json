{
  "version": 1,
  "scope": "measurement only; no converter support changes",
  "families": {
    "development": [
      "Inno Setup",
      "innounp"
    ],
    "control_not_development": [
      "WinSCP"
    ],
    "reserved_storage": [
      "CrystalDiskMark",
      "DiskSpd"
    ],
