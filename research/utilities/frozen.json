  },
  "iscc_arguments": [
    "/Q",
    "/F<case>",
    "/O<unique-scratch-output>",
    "<script>"
  ],
  "forbidden": [
    "generated installer execution",
    "signing",
    "network transfers",
    "driver/storage workloads",
