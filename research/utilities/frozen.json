      "VirtualDub"
    ]
  },
  "cases": [
    {
      "name": "minimal",
      "fixture": "minimal.iss",
      "exit": 0,
      "output": "PE artifact; never execute",
      "repeat": 2
    },
    {
      "name": "payload",
      "fixture": "payload.iss",
      "exit": 0,
      "output": "PE artifact; never execute",
      "repeat": 2
    },
    {
      "name": "invalid",
      "fixture": "invalid.iss",
      "exit": 2,
      "output": "none",
      "repeat": 1
    },
    {
      "name": "bad-option",
      "args": [
        "/W2LUnknownOption"
      ],
      "exit": 1,
      "output": "none",
      "repeat": 1
    }
  ],
  "fixture_sha256": {
    "invalid.iss": "2e4b7bd3b2c27562b9e067759429b4d77a315bcaf5c1eaabad881b8ad2cbbd1f",
    "minimal.iss": "289634c28ac2651bbbd4e5289bc51921af4057166eb213af8329e45ab6473591",
