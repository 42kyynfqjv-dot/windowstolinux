    {"id": "unsigned_limits_both_width_forms", "format_ascii": "%u/%lu/%u/%lu\u0000", "arguments_u32": [4294967295, 2147483648, 0, 1], "expected_ascii": "4294967295/2147483648/0/1", "consumed_arguments": 4},
    {"id": "same_word_distinct_signedness", "format_ascii": "%d %u %ld %lu\u0000", "arguments_u32": [4294967295, 4294967295, 4294967295, 4294967295], "expected_ascii": "-1 4294967295 -1 4294967295", "consumed_arguments": 4},
