    {"id": "decimal_digit_transitions", "format_ascii": "%d,%d,%d,%u,%u,%lu\u0000", "arguments_u32": [9, 10, 99, 100, 999, 1000], "expected_ascii": "9,10,99,100,999,1000", "consumed_arguments": 6},
    {"id": "reordered_signedness", "format_ascii": "<%u><%d><%lu><%li>\u0000", "arguments_u32": [1, 4294967295, 2, 2147483648], "expected_ascii": "<1><-1><2><-2147483648>", "consumed_arguments": 4},
    {"id": "unused_unknown_word_is_not_read", "format_ascii": "%d\u0000", "arguments_u32": [7, null, 2147483648], "expected_ascii": "7", "consumed_arguments": 1},
    {"id": "nul_stops_before_unsafe_conversion", "format_ascii": "%u\u0000%n%ls", "arguments_u32": [17, null], "expected_ascii": "17", "consumed_arguments": 1},
    {"id": "negative_digit_transitions", "format_ascii": "%li,%d,%ld,%i\u0000", "arguments_u32": [4294967295, 4294967287, 4294967286, 4294967196], "expected_ascii": "-1,-9,-10,-100", "consumed_arguments": 4},
